# Architecture
CONFIG_ARCH="arm"
CONFIG_ARCH_FAMILY="armv7-m"
CONFIG_ARCH_CHIP_STM32H7=y
CONFIG_ARCH_CHIP="stm32h743vi"
CONFIG_ARCH_CHIP_STM32H743=y
CONFIG_ARMV7M_L1_CACHE=y
CONFIG_ARMV7M_DCACHE=y
CONFIG_ARMV7M_ICACHE=y
CONFIG_ARMV7M_FPU=y
CONFIG_CORTEXM7=y
CONFIG_ARMV7M_FPU_DOUBLE_PRECISION=y
CONFIG_ARMV7M_STACKCHECK=y
CONFIG_ARMV7M_ITMS=y
# Explicitly unset ARCH_CHIP_UNSET to ensure STM32H7 selection
CONFIG_ARCH_CHIP_UNSET=n

# Board
CONFIG_ARCH_BOARD_CUSTOM=y
CONFIG_ARCH_BOARD_CUSTOM_DIR="../../../../boards/px4/pixeagle/nuttx-config"
CONFIG_ARCH_BOARD="px4_pixeagle"
CONFIG_BOARD_LOOPSPERMSEC=480000

# NuttX Features
CONFIG_NAME_STRING="NuttX"
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_DEFAULT_SMALL=y
CONFIG_STACK_COLORATION=y
CONFIG_BOOT_RUNFROMFLASH=y
CONFIG_RTOS_INTSTACK_SIZE=2048
CONFIG_MM_DEFAULT_CIRCBUF_SIZE=1024
CONFIG_MM_CIRCBUF=y

# Drivers
CONFIG_SPI=y
CONFIG_STM32H7_SPI1=y
CONFIG_STM32H7_SPI2=y
CONFIG_STM32H7_SPI3=y
CONFIG_STM32H7_SPI4=y
CONFIG_MMCSD=y
CONFIG_MMCSD_SPI=y
CONFIG_I2C=y
CONFIG_STM32H7_I2C1=y
CONFIG_STM32H7_I2C3=y
CONFIG_STM32H7_I2C4=y
CONFIG_I2C_RESET=y
CONFIG_STM32H7_FDCAN1=y
CONFIG_STM32H7_FDCAN2=y
CONFIG_UAVCAN_STM32=y
CONFIG_UAVCAN_STM32_TIMER=2
CONFIG_UAVCAN=y
CONFIG_CAN=y
CONFIG_STM32H7_CAN=y
CONFIG_SERIAL=y
CONFIG_STM32H7_UART2=y
CONFIG_STM32H7_UART3=y
CONFIG_STM32H7_UART4=y
CONFIG_STM32H7_UART5=y
CONFIG_STM32H7_UART7=y
CONFIG_STM32H7_UART8=y
CONFIG_STM32H7_USART2=y
CONFIG_STM32H7_USART3=y
CONFIG_STM32H7_USART_RTSCTS=y
CONFIG_STM32H7_ADC1=y
CONFIG_STM32H7_ADC=y
CONFIG_ADC=y
CONFIG_PWM=y
CONFIG_STM32H7_PWM1=y
CONFIG_STM32H7_PWM3=y
CONFIG_STM32H7_PWM4=y
CONFIG_STM32H7_PWM5=y
CONFIG_STM32H7_PWM8=y
CONFIG_STM32H7_TIM1=y
CONFIG_STM32H7_TIM2=y
CONFIG_STM32H7_TIM3=y
CONFIG_STM32H7_TIM4=y
CONFIG_STM32H7_TIM5=y
CONFIG_STM32H7_TIM8=y
CONFIG_STM32H7_EXTI=y
CONFIG_GPIO=y
CONFIG_STM32H7_GPIO=y
CONFIG_LEDS=y
CONFIG_LEDS_ARCH=y
CONFIG_USBDEV=y
CONFIG_STM32H7_OTGFS=y
CONFIG_STM32H7_USB=y

# File System
CONFIG_FS_FAT=y
CONFIG_MTD=y
CONFIG_MTD_CONFIG=y
CONFIG_MTD_FRAM=y
CONFIG_FS_PROCFS=y
CONFIG_NFILE_DESCRIPTORS=16
CONFIG_FS_WRITABLE=y

# Serial Console
CONFIG_SERIAL_TERMIOS=y
CONFIG_SERIAL_NPOLLWAITERS=2
CONFIG_UART4_SERIAL_CONSOLE=y
CONFIG_UART4_RXBUFSIZE=256
CONFIG_UART4_TXBUFSIZE=256

# System
CONFIG_INIT_NONE=y
CONFIG_USERMAIN_NAME="px4"
CONFIG_START_YEAR=2025
CONFIG_START_MONTH=9
CONFIG_START_DAY=25
CONFIG_DEFAULT_IOB_NBUFFERS=8
CONFIG_DEFAULT_IOB_BUFSIZE=512

# Debug
CONFIG_SYSTEM_NSH=y
CONFIG_SYSTEM_NSH_TELNET=y
CONFIG_SYSTEM_NSH_TELNET_PORT=2323
CONFIG_DEBUG_FEATURES=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_MM=y
CONFIG_DEBUG_SCHED=y
CONFIG_DEBUG_SYMBOLS=y
