CONFIG_ARCH_CHIP_STM32H743=y
CONFIG_BOARD_PIXEAGLE=y
CONFIG_ARCH_CHIP="stm32h7"
CONFIG_STM32H7=y
CONFIG_SOC_STM32H743=y
CONFIG_ARCH_CHIP_STM32H743VI=y
CONFIG_ARCH_CHIP_STM32H7=y
CONFIG_ARCH_CHIP_CUSTOM=n
CONFIG_ARCH_BOARD_CUSTOM=y
CONFIG_ARCH_BOARD_CUSTOM_DIR="../../../../boards/px4/pixeagle/nuttx-config"
CONFIG_ARCH_BOARD="px4_pixeagle"
CONFIG_ARCH_CHIP_UNSET=n
CONFIG_STM32H7_FLASH_2048KB=y
CONFIG_NSH_LIBRARY=n
CONFIG_SYSTEM_CMDS=n

# Clock configuration (using HSI at 16MHz for bootloader simplicity)
CONFIG_STM32H7_BOARD_USEHSI=y
CONFIG_STM32H7_HSI_FREQUENCY=16000000
CONFIG_STM32H7_SYSCLK_FREQUENCY=16000000
CONFIG_STM32H7_HCLK_FREQUENCY=16000000

# Serial console configuration (UART4 for debug output)
CONFIG_STM32H7_UART4=y
CONFIG_UART4_SERIAL_CONSOLE=y
CONFIG_UART4_BAUD=115200

# Bootloader specific configurations
CONFIG_BOOTLOADER_SIZE=65536
CONFIG_BOOT_SERIAL_BAUD=115200
CONFIG_BOOT_SERIAL_UART="UART4"

# Memory protection (MPU) configuration
CONFIG_ARCH_HAVE_MPU=y
CONFIG_ARM_MPU=y

# Flash configuration
CONFIG_STM32H7_FLASH_PREFETCH=y
CONFIG_STM32H7_FLASH_ART_ENABLE=y
CONFIG_STM32H7_FLASH_WAITSTATES=2

# Minimal system configuration for bootloader
CONFIG_DISABLE_OS_API=y
CONFIG_SCHED_WORKQUEUE=n
CONFIG_SCHED_HPWORK=n
CONFIG_SCHED_LPWORK=n
CONFIG_BOOT_BANNER=n

# Disable unnecessary features for bootloader
CONFIG_FS_PROCFS=n
CONFIG_MM_SMALL=n
CONFIG_NET=n
CONFIG_NETDEV_PHY_IOCTL=n
