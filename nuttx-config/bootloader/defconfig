# Bootloader configuration for Pixeagle (STM32H743VIT6, 16MHz HSE)
# Minimal config for bootloader, enables UART4 (PC10/PC11, /dev/ttyS3, debug).
# No sensor power (PA15 GPIO_VDD_5V_PERIPH_EN) or SPI/I2C/PWM in bootloader.
# Hardware: CAN1 (PD0/PD1), USART2 (PD3-PD6), BMI088 (PB2 GYR CS), PPM (PB1).

# CONFIG_ARM=y
# CONFIG_ARMV7M=y
 
CONFIG_ARCH_CHIP_STM32H743=y

