#!/bin/sh
#
# board specific defaults
#------------------------------------------------------------------------------

# Battery voltage divider: 10k + 1k = 11:1 ratio
param set-default BAT1_V_DIV 11
param set-default BAT2_V_DIV 11

# Current sensor calibration (adjust based on your actual current sensor)
# Default value for common 50A sensors with 100A shunt: 36.367515152
# For different sensors, you may need to calculate:
# A_PER_V = Max_Current / (Vref * Gain)
param set-default BAT1_A_PER_V 36.367515152
param set-default BAT2_A_PER_V 36.367515152

# Additional defaults for your board
param set-default SENS_BOARD_ROT 0
param set-default SENS_BOARD_X_OFF 0
param set-default SENS_BOARD_Y_OFF 0
param set-default SENS_BOARD_Z_OFF 0
