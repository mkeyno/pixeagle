#!/bin/sh
#
# Pixeagle specific board sensors init
#------------------------------------------------------------------------------
# board_adc start

board_adc start

# Internal SPI1 BMI088 accel/gyro
# ACC CS: PA4, GYR CS: PB2, SPI1 bus
bmi088 -A -R 0 -s -b 1 start
bmi088 -G -R 0 -s -b 1 start

# Internal SPI4 ICM-42688-P
# CS: PE4, SPI4 bus
icm42688p -R 0 -s -b 4 start

# Internal I2C3 BMP388 (address 0x77)
bmp388 -I -b 3 -a 0x77 start

# Internal I2C3 IST8310 (address 0x0e)
ist8310 -I -b 3 -a 0x0e -R 0 start

# Internal I2C4 BMP390 (address 0x77)
bmp390 -I -b 4 -a 0x77 start

# Optional: External I2C1 for additional sensors
# ist8310 -X -b 1 -a 0x0e -R 0 start
