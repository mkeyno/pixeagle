{
        "version": "2.0.0",
        "tasks": [
                
                {
                        "label": "px4_sitl_cleanup",
                        "type": "shell",
                        "command": "rm -rfv /tmp/px4* || true",
                        "presentation": {
                                "echo": true,
                                "reveal": "never",
                                "revealProblems": "onProblem",
                                "focus": false,
                                "panel": "dedicated",
                                "showReuseMessage": false,
                                "clear": false,
                                "close": true
                        },
                        "problemMatcher": [],
                        "dependsOn": [
                                "px4_kill"
                        ]
                },
                {
                        "label": "px4_kill",
                        "type": "shell",
                        "command": "pkill -9 px4 || true",
                        "presentation": {
                                "echo": true,
                                "reveal": "never",
                                "revealProblems": "onProblem",
                                "focus": false,
                                "panel": "dedicated",
                                "showReuseMessage": false,
                                "clear": false,
                                "close": true
                        },
                        "problemMatcher": []
                },
                {
                        "label": "mavlink shell",
                        "type": "shell",
                        "command": "./Tools/mavlink_shell.py",
                        "options": {
                                "cwd": "${workspaceFolder}"
                        },
                        "presentation": {
                                "echo": true,
                                "reveal": "always",
                                "focus": true,
                                "panel": "new",
                                "showReuseMessage": false,
                                "clear": false
                        },
                        "problemMatcher": []
                },
                {
                        "label": "miniterm.py",
                        "type": "shell",
                        "command": "miniterm.py --raw - 57600",
                        "options": {
                                "cwd": "${workspaceFolder}"
                        },
                        "presentation": {
                                "echo": true,
                                "reveal": "always",
                                "focus": true,
                                "panel": "new",
                                "showReuseMessage": false,
                                "clear": false
                        },
                        "problemMatcher": []
                },
                {
                        "type": "cppbuild",
                        "label": "C/C++: gcc build active file",
                        "command": "/usr/lib/ccache/gcc",
                        "args": [
                                "-fdiagnostics-color=always",
                                "-g",
                                "${file}",
                                "-o",
                                "${fileDirname}/${fileBasenameNoExtension}"
                        ],
                        "options": {
                                "cwd": "${fileDirname}"
                        },
                        "problemMatcher": [
                                "$gcc"
                        ],
                        "group": {
                                "kind": "build",
                                "isDefault": true
                        },
                        "detail": "Task generated by Debugger."
                },


                {
                        "label": "fix-usb-perms",
                        "type": "shell",
                        "command": "bash",
                                "args": [
                                        "-c",
                                        "for dev in $(lsusb | grep 'ST-LINK' | awk '{print $2 \":\" $4}' | sed 's/://'); do device=\"/dev/bus/usb/${dev:0:3}/${dev:4:3}\"; if [ -e \"$device\" ]; then sudo chmod a+rw \"$device\"; echo \"Fixed: $device\"; fi; done"
                                ],
                        "problemMatcher": []
                },
                {
                        "label": "test-stlink",
                        "type": "shell",
                        "command": "st-info --probe",
                        "problemMatcher": []
                },
                {
                "label": "build px4",
                "type": "shell",
                "command": "make",
                "args": ["px4_pixeagle_default"],
                "group": {
                        "kind": "build",
                        "isDefault": true
                }
                },




                {
                        "label": "Flash PX4 PixEagle Bootloader (OpenOCD)",
                        "type": "shell",
                        "command": "/usr/local/bin/openocd",
                        "args": [
                                "-s", "/usr/local/share/openocd/scripts",
                                "-f", "interface/stlink.cfg",
                                "-f", "target/stm32h7x_dual_bank.cfg",
                                "-c", "init",
                                "-c", "reset halt",
                                "-c", "stm32h7x mass_erase 0",          // erase bank 0 (bootloader area)
                                "-c", "program ${workspaceFolder}/build/px4_pixeagle_bootloader/px4_pixeagle_bootloader.elf verify reset exit"   // adjust path/name if different
                        ],
                        "options": { "cwd": "${workspaceFolder}" },
                        "group": "build",
                        "problemMatcher": [],
                        "presentation": { "reveal": "always", "panel": "shared", "clear": true }
                },


                {
                        "label": "Flash PX4 PixEagle Main Firmware (OpenOCD)",
                        "type": "shell",
                        "command": "/usr/local/bin/openocd",
                        "args": [
                                "-s", "/usr/local/share/openocd/scripts",
                                "-f", "interface/stlink.cfg",
                                "-f", "target/stm32h7x_dual_bank.cfg",
                                "-c", "program ${workspaceFolder}/build/px4_pixeagle_default/px4_pixeagle_default.elf verify reset exit"
                        ],
                        "options": { "cwd": "${workspaceFolder}" },
                        "group": {
                                "kind": "build",
                                "isDefault": true   // ← optional: make this the default build task
                        },
                        "problemMatcher": [],
                        "presentation": { "reveal": "always", "panel": "shared", "clear": true }
                }







        ],
        "inputs": [
                {
                        "type": "pickString",
                        "id": "gzWorld",
                        "description": "gz world",
                        "options": [
                                "default"
                        ],
                        "default": "default"
                }
        ]
}
