# default.px4board
#
# Board configuration for Pixeagle default variant (STM32H743VIT6, 16MHz HSE).
# Enables drivers and modules for:
# - SPI1 (BMI088: PA4 CS_ACC, PB2 CS_GYR, PA5-7, PC4/PC5 interrupts)
# - SPI2 (MicroSD: PB11 CS, FM25V01A-GTR: PD10 CS, PB10/14/15)
# - SPI3 (external: PB3-5, PD7 CS), SPI4 (ICM-42688-P: PE4 CS, PE2/5/6, PE3 DRDY)
# - I2C1 (external: PB6/7), I2C3 (IST8310: 0x0E, BMP388: 0x76, PC9/PA8)
# - I2C4 (BMP390: 0x76, PB8/9)
# - UART3 (/dev/ttyS1, PD8/9, SBUS/PPM), UART4 (/dev/ttyS3, PC10/11, debug)
# - UART5 (/dev/ttyS2, PC12/PD2, sensors), USART2 (/dev/ttyS0, PD3-6, telemetry)
# - UART7 (/dev/ttyS4, PE7-10, CM4), UART8 (/dev/ttyS5, PE0/1, reserved)
# - CAN1 (PD0/1, AF9), CAN2 (PB12/13), both 5V via TCAN1044VDRQ1
# - TIM1 (PWM OUT 8: PA10, AUX6: PE11, WS2812B: PE14 via FastLED)
# - TIM3 (PWM OUT 5: PC6, AUX5: PB0, PPM: PB1), TIM4 (PWM OUT 1-4: PD12-15)
# - TIM5 (AUX 1-4: PA0-3), TIM8 (PWM OUT 6: PC7, OUT 7: PC8)
# - ADC (PC0-3, 11:1 divider for 5S LiPo)
# - Sensor power: PA15 (GPIO_VDD_5V_PERIPH_EN, active high)
# No PX4IO. FastLED linked in src/CMakeLists.txt for WS2812B.


CONFIG_BOARD_TOOLCHAIN="arm-none-eabi"
CONFIG_BOARD_ARCHITECTURE="cortex-m7"
CONFIG_BOARD_CONSTRAINED_FLASH=y
CONFIG_BOARD_UAVCAN_INTERFACES=2
CONFIG_BOARD_SERIAL_TEL1="/dev/ttyS0"  # USART2 (PD3-6, telemetry)
CONFIG_BOARD_SERIAL_GPS1="/dev/ttyS2"  # UART5 (PC12/PD2, sensors)
CONFIG_BOARD_SERIAL_TEL2="/dev/ttyS3"  # UART4 (PC10/11, debug)
CONFIG_BOARD_SERIAL_TEL3="/dev/ttyS1"  # UART3 (PD8/9, SBUS/PPM)
CONFIG_BOARD_SERIAL_TEL4="/dev/ttyS4"  # UART7 (PE7-10, CM4)
CONFIG_BOARD_PWM_FREQ=400
CONFIG_STM32H7_SPI1=y
CONFIG_STM32H7_SPI2=y
CONFIG_STM32H7_SPI3=y
CONFIG_STM32H7_SPI4=y
CONFIG_STM32H7_I2C1=y
CONFIG_STM32H7_I2C3=y
CONFIG_STM32H7_I2C4=y
CONFIG_STM32H7_USART2=y
CONFIG_STM32H7_USART3=y
CONFIG_STM32H7_UART4=y
CONFIG_STM32H7_UART5=y
CONFIG_STM32H7_UART7=y
CONFIG_STM32H7_UART8=y
CONFIG_STM32H7_FDCAN1=y
CONFIG_STM32H7_FDCAN2=y
CONFIG_STM32H7_ADC1=y
CONFIG_STM32H7_TIM1=y
CONFIG_STM32H7_TIM2=y
CONFIG_STM32H7_TIM3=y
CONFIG_STM32H7_TIM4=y
CONFIG_STM32H7_TIM5=y
CONFIG_STM32H7_TIM8=y
CONFIG_STM32H7_OTGFS=y
CONFIG_USBDEV=y
CONFIG_USBDEV_BUSPOWERED=y
CONFIG_USBDEV_MAXPOWER=500
CONFIG_MMCSD=y
CONFIG_MMCSD_SPI=y
CONFIG_ARCH_HAVE_LEDS=y
CONFIG_ARCH_LEDS=y
CONFIG_ARCH_HAVE_BUTTONS=y
CONFIG_ARCH_BUTTONS=y
CONFIG_PWM=y
CONFIG_STM32H7_PWM=y
CONFIG_WS2812=y
CONFIG_RGBLED=y
CONFIG_BOARD_HAS_SAFETY_SWITCH=y
CONFIG_BOARD_HAS_BUZZER=y
CONFIG_BOARD_HAS_HW_VERSIONING=y
CONFIG_DRIVERS_ADC_BOARD_ADC=y
CONFIG_DRIVERS_BAROMETER_BMP388=y
CONFIG_DRIVERS_BAROMETER_BMP390=y
CONFIG_DRIVERS_IMU_BOSCH_BMI088=y
CONFIG_DRIVERS_IMU_INVENSENSE_ICM42688P=y
CONFIG_DRIVERS_MAGNETOMETER_ISENTEK_IST8310=y
CONFIG_DRIVERS_PWM_OUT=y
CONFIG_DRIVERS_TONE_ALARM=y
CONFIG_DRIVERS_TELEMETRY=y
CONFIG_DRIVERS_UAVCAN_V1=y
#CONFIG_DRIVERS_UAVCAN=y
CONFIG_BOARD_UAVCAN_TIMER_OVERRIDE=2
CONFIG_MODULES_BATTERY_STATUS=y
CONFIG_MODULES_COMMANDER=y
CONFIG_MODULES_CONTROL_ALLOCATOR=y
CONFIG_MODULES_DATAMAN=y
CONFIG_MODULES_EKF2=y
CONFIG_MODULES_EVENTS=y
CONFIG_MODULES_FLIGHT_MODE_MANAGER=y
CONFIG_MODULES_GYRO_CALIBRATION=y
CONFIG_MODULES_LAND_DETECTOR=y
CONFIG_MODULES_LOGGER=y
CONFIG_MODULES_MANUAL_CONTROL=y
CONFIG_MODULES_MAVLINK=y
CONFIG_MODULES_MC_ATT_CONTROL=y
CONFIG_MODULES_MC_POS_CONTROL=y
CONFIG_MODULES_MC_RATE_CONTROL=y
CONFIG_MODULES_NAVIGATOR=y
CONFIG_MODULES_RC_UPDATE=y
CONFIG_MODULES_SENSORS=y
CONFIG_MODULES_TEMPERATURE_COMPENSATION=y
CONFIG_SYSTEMCMDS_ACTUATOR_TEST=y
CONFIG_SYSTEMCMDS_DMESG=y
CONFIG_SYSTEMCMDS_HARDFAULT_LOG=y
CONFIG_SYSTEMCMDS_I2CDETECT=y
CONFIG_SYSTEMCMDS_LED_CONTROL=y
CONFIG_SYSTEMCMDS_MFT=y
CONFIG_SYSTEMCMDS_MTD=y
CONFIG_SYSTEMCMDS_NSHTERM=y
CONFIG_SYSTEMCMDS_PARAM=y
CONFIG_SYSTEMCMDS_PERF=y
CONFIG_SYSTEMCMDS_REBOOT=y
CONFIG_SYSTEMCMDS_SD_BENCH=y
CONFIG_SYSTEMCMDS_SYSTEM_TIME=y
CONFIG_SYSTEMCMDS_TOP=y
CONFIG_SYSTEMCMDS_UORB=y
CONFIG_SYSTEMCMDS_VER=y
CONFIG_SYSTEMCMDS_WORK_QUEUE=y